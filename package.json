{
  "name": "taxsteps",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase/tests"
  ],
  "scripts": {
    "test": "npm run test -w @taxsteps/core && npm run test:functions",
    "test:core": "npm run test -w @taxsteps/core",
    "test:functions": "node scripts/test-functions.mjs",
    "test:db": "npm run test -w @taxsteps/db-tests",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "supabase": "^2.119.0"
  }
}
