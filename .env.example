# Tax Steps — environment variables. Copy the relevant block into the file named
# in each heading. Real values are never committed.

# ── apps/web/.env.local (public: shipped to the browser) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # publishable (anon) key — safe for clients, RLS protects data

# ── apps/mobile/.env (public: bundled into the app) ────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=            # same as above
EXPO_PUBLIC_SUPABASE_ANON_KEY=       # same publishable key
EXPO_PUBLIC_WEB_URL=                 # e.g. http://localhost:3000 — used for password-reset links

# ── supabase/functions/.env (SERVER ONLY: set with `npx supabase secrets set --env-file`) ──
AI_PROVIDER=openai                   # extraction provider (DocumentExtractionService)
AI_API_KEY=                          # OpenAI API key — never put this in a client app
AI_MODEL=gpt-6.1-sol                 # OpenAI vision model id
GOOGLE_CLIENT_ID=                    # Google Cloud OAuth web client (Sheets export)
GOOGLE_CLIENT_SECRET=                # Google OAuth client secret — server only
TOKEN_ENCRYPTION_KEY=                # base64 32 bytes; encrypts stored Google refresh tokens
OAUTH_STATE_SECRET=                  # base64 32 bytes; signs OAuth state parameters
APP_WEB_URL=http://localhost:3000    # where OAuth callbacks return on the web
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081   # CORS allow-list (CSV)
APP_MOBILE_SCHEME=taxsteps           # deep-link scheme for the mobile app
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.

# ── .env.test (local only: database integration tests) ─────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server-only key used to create/delete throwaway test users
